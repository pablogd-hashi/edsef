<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Inbox watcher — imports photos from a shared iCloud Drive folder.

  1. Edit USER paths and WorkingDirectory
  2. cp deploy/launchd/com.memoria.inbox.plist.example ~/Library/LaunchAgents/com.memoria.inbox.plist
  3. launchctl load ~/Library/LaunchAgents/com.memoria.inbox.plist
  4. launchctl start com.memoria.inbox

  Logs: ~/Library/Logs/memoria-inbox.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.memoria.inbox</string>

  <key>WorkingDirectory</key>
  <string>/Users/TU_USUARIO/edsef</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/TU_USUARIO/edsef/scripts/prod/inbox-watch.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/TU_USUARIO/Library/Logs/memoria-inbox.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/TU_USUARIO/Library/Logs/memoria-inbox.error.log</string>
</dict>
</plist>
