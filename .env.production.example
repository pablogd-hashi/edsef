# ─── Memoria — producción en MacBook ─────────────────────────────────────────
# Copia a .env y ajusta antes del primer arranque:
#   cp .env.production.example .env

NODE_ENV=production

# Carpeta absoluta recomendada (fotos, videos, exports)
# Ejemplo: /Users/tuusuario/memoria-data/storage
STORAGE_PATH="./storage"

# Tras crear tu cuenta de mamá/papá, pon false
ALLOW_REGISTRATION="false"

# ─── Base de datos (Docker) ───────────────────────────────────────────────────
POSTGRES_USER=memoria
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE_SEGURA
POSTGRES_DB=memoria
DATABASE_URL="postgresql://memoria:CAMBIA_ESTA_CLAVE_SEGURA@127.0.0.1:5432/memoria"

# ─── Redis (opcional; workers no requeridos por ahora) ─────────────────────────
REDIS_URL="redis://127.0.0.1:6379"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
AUTH_SECRET=CAMBIA_ESTE_SECRETO_MIN_32_CARACTERES

# URL con la que accedes desde el navegador (LAN o localhost)
# iPhone en la misma WiFi: http://192.168.x.x:3000
# Solo esta Mac: http://localhost:3000
AUTH_URL="http://localhost:3000"

# Puerto de la app (npm run prod:start)
PORT=3000
HOSTNAME=0.0.0.0

# ─── Límites de subida (bytes) ────────────────────────────────────────────────
MAX_IMAGE_SIZE=20971520
MAX_VIDEO_SIZE=524288000

# PDF export (opcional): npx playwright install chromium
