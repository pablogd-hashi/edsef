# ─── Memoria — MacBook production ─────────────────────────────────────────────
# Copy to .env before first start:
#   cp .env.production.example .env

NODE_ENV=production

# Absolute path recommended (photos, videos, exports)
# Example: /Users/you/memoria-data/storage
STORAGE_PATH="./storage"

# Sign-up is open only until the first account exists; partners join by invite.
# ALLOW_REGISTRATION=""

# ─── Database (Docker) ────────────────────────────────────────────────────────
POSTGRES_USER=memoria
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=memoria
DATABASE_URL="postgresql://memoria:CHANGE_THIS_SECURE_PASSWORD@127.0.0.1:5432/memoria"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_THIS_SECRET_MIN_32_CHARACTERS

# Must match the URL in the browser (LAN, Tailscale, or localhost)
# Same Wi‑Fi iPhone: http://192.168.x.x:3000
# Tailscale:        http://100.x.x.x:3000
# This Mac only:    http://localhost:3000
# See docs/remote-access.md
AUTH_URL="http://localhost:3000"

# App port (npm run prod:start)
PORT=3000
HOSTNAME=0.0.0.0

# Shared iCloud Drive inbox (partner drops photos here; watcher imports them)
# ICLOUD_INBOX_PATH="/Users/you/Library/Mobile Documents/com~apple~CloudDocs/Memoria Inbox"
# ICLOUD_INBOX_POLL_MS=30000

# ─── Upload limits (bytes) ────────────────────────────────────────────────────
MAX_IMAGE_SIZE=20971520
MAX_VIDEO_SIZE=524288000

# PDF export (optional): npx playwright install chromium

# Backups (scripts/prod/backup.sh, nightly via install-launchagents.sh)
# BACKUP_DIR="/Users/you/Memoria-Backups"   # absolute path; default is ~/Memoria-Backups
# Copy every backup to an external drive when it is plugged in:
# BACKUP_EXTERNAL_DIR="/Volumes/Memoria/Backups"
