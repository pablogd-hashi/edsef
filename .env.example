# Local storage (photos & videos)
STORAGE_PATH="./storage"

# Set to false on private/local installs after creating your account
ALLOW_REGISTRATION="true"

# Database
DATABASE_URL="postgresql://memoria:memoria_dev@localhost:5432/memoria"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth.js
AUTH_SECRET="dev-secret-change-in-production-min-32-chars-long"
AUTH_URL="http://localhost:3000"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="memoria-media"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# Optional secondary backup destination
# S3_BACKUP_ENDPOINT=""
# S3_BACKUP_ACCESS_KEY=""
# S3_BACKUP_SECRET_KEY=""
# S3_BACKUP_BUCKET=""

# Upload limits (bytes)
MAX_IMAGE_SIZE=20971520
MAX_VIDEO_SIZE=524288000
MAX_DOCUMENT_SIZE=52428800

# Signed URL expiration (seconds)
SIGNED_URL_EXPIRY=3600
