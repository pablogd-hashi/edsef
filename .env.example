# Local storage (photos & videos)
STORAGE_PATH="./storage"

# Set to false on private/local installs after creating your account
ALLOW_REGISTRATION="true"

# Production on MacBook: see docs/production-mac.md
#   cp .env.production.example .env
#   ./scripts/prod/setup-mac.sh

# Database
DATABASE_URL="postgresql://memoria:memoria_dev@localhost:5432/memoria"

# Auth.js — must match the URL in the browser (see docs/remote-access.md)
# First-time on this Mac: http://localhost:3000
# Whole house on Wi-Fi: http://Your-Mac.local:3000 (stable) or the LAN IP
AUTH_SECRET="dev-secret-change-in-production-min-32-chars-long"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# Shared iCloud Drive (or local) drop-box. Per-child subfolders by nickname.
# ICLOUD_INBOX_PATH="~/Library/Mobile Documents/com~apple~CloudDocs/Memoria Inbox"
# ICLOUD_INBOX_POLL_MS=30000

# Upload limits (bytes)
MAX_IMAGE_SIZE=20971520
MAX_VIDEO_SIZE=524288000
MAX_DOCUMENT_SIZE=52428800

# Signed URL expiration (seconds)
SIGNED_URL_EXPIRY=3600
